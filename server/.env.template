# Connective AI Core Configuration
# ============================================================
# Only App-level credentials (OAuth) are required here. 
# Individual user tokens will be stored securely in storage.json 
# after they log in through the application UI.

# --- LLM Provider ---
GROQ_API_KEY=your_groq_api_key

# --- GitHub OAuth ---
# Get these at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Notion OAuth ---
# Get these at: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# --- Google OAuth (Gmail & Drive) ---
# Get these at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Slack OAuth ---
# Get these at: https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# --- Salesforce OAuth ---
# Get these at Salesforce Setup > App Manager > New Connected App
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret

# --- Platform Security ---
JWT_SECRET=your_super_secret_key_change_me_immediately
JWT_EXPIRY_MINUTES=60
PORT=3000
FRONTEND_URL=http://localhost:5173